# P2.1 — Contoh env lokal. Salin ke .env.local (sudah di-gitignore via *.local)
# lalu export ke shell sebelum menjalankan skrip db:* atau next dev.
# JANGAN commit nilai asli ke repo.
#
# Nilai produksi: dashboard Vercel → tim sekawan → project tka-sma
# → Settings → Environment Variables → DATABASE_URL.
# Lihat docs/decisions/P2-neon-drizzle.md (bagian "Sumber connection string").

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
